# --- Database ---
# Local development uses SQLite. For Vercel you need an external DB (see README).
DATABASE_URL="file:./dev.db"

# --- Data mode ---
# "live"  = call real Polymarket public APIs (no keys required)
# "demo"  = use clearly-labeled demo data only (no network calls)
DATA_MODE="live"

# --- Optional: Discord webhook for end-of-day reports & important alerts ---
# Leave empty to skip Discord delivery (reports are still stored in the DB).
DISCORD_WEBHOOK_URL=""

# --- Optional: request pacing for public APIs ---
API_DELAY_MS="250"

# NOTE: There is intentionally NO private key, NO wallet secret, NO exchange
# credential anywhere in this app. Version one is paper trading only.

# --- Optional: agent heartbeat API (POST /api/agents/state) ---
# Shared secret for Hermes/other agents to report their status to the dashboard.
# Leave empty to disable the write endpoint entirely (GET stays available).
INTERNAL_API_SECRET=""

# --- C-200 maker-fill credit (rust-sidecar, 2026-10-10) ---
# The sidecar books every BANKROLL_200 BUY `credit` inside the spread. The credit
# used to be a flat 2¢ on every leg; measured on 2026-10-10 (354 intents), the
# level is reachable on only ~18% of legs, band-dependent, so the default is now
# the measured per-band share (0.028/0.084/0.229/0.188/0.185).
# "measured" = 2¢ × the band's measured share (default; leave unset for this)
# "modelled" = the pre-2026-10-10 flat 2¢ — set this to revert without a rebuild
#              (edit here, then: launchctl kickstart -k gui/$(id -u)/com.xsnyde2.copybot-rust-sidecar)
MAKER_CREDIT_MODE="measured"

# --- Jev shadow lane (write-only instrumentation; default OFF) ---
# The lane marks one row per scored leg and compares a model's probability against the PRICE-ONLY
# arm (the detection mid). Nothing here touches live rules, sizing or positions.
JEV_SHADOW="0"                 # 1 = arm live (calls a model); 0 = collect states only
JEV_PROVIDER="local"           # "local" = Ollama on Odin (qwen3.5:9b, $0/call, needs no key)
                               # "openrouter" = the vendor Decisions route (needs OPENROUTER_API_KEY)
JEV_LOCAL_URL="http://192.168.1.106:11434/api/chat"   # local provider only
JEV_MODEL="qwen3.5:9b"         # local default; the vendor default is typesafe/jev-1.13
JEV_BACKFILL_LIMIT="100"       # stored states replayed per run (raise to drain a backlog)
JEV_BACKFILL_FLUSH="100"       # rows appended per flush during a long backfill (crash-safety)
JEV_COLLECT_LIMIT="200"        # scored legs collected per run
JEV_WINDOW_HOURS="24"          # collection window
JEV_GATE_THRESHOLD="0.55"      # pre-registered gate; do not tune this to the sample
