# --- Database ---
# Local development uses SQLite. For Vercel you need an external DB (see README).
DATABASE_URL="file:./dev.db"

# --- Data mode ---
# "live"  = call real Polymarket public APIs (no keys required)
# "demo"  = use clearly-labeled demo data only (no network calls)
DATA_MODE="live"

# --- Optional: Discord webhook for end-of-day reports & important alerts ---
# Leave empty to skip Discord delivery (reports are still stored in the DB).
DISCORD_WEBHOOK_URL=""

# --- Optional: request pacing for public APIs ---
API_DELAY_MS="250"

# NOTE: There is intentionally NO private key, NO wallet secret, NO exchange
# credential anywhere in this app. Version one is paper trading only.

# --- Optional: agent heartbeat API (POST /api/agents/state) ---
# Shared secret for Hermes/other agents to report their status to the dashboard.
# Leave empty to disable the write endpoint entirely (GET stays available).
INTERNAL_API_SECRET=""
