[{"_id":"68808c50176141d660945511","id":"yunfanlu/RGB-Event-ISP-Dataset","author":"yunfanlu","disabled":false,"gated":false,"lastModified":"2026-04-27T03:49:20.000Z","likes":2,"private":false,"sha":"239d7a27a0e09d3244a93379767529e6210aeb2f","downloads":8833,"tags":["license:cc-by-nc-sa-4.0","size_categories:1K<n<10K","format:imagefolder","modality:image","library:datasets","library:mlcroissant","region:us","event"],"createdAt":"2025-07-23T07:16:32.000Z","key":""},{"_id":"6a9e7dbf870d3fae9dc999be","id":"shiyi666777/RGB-Event-ISP-Dataset","author":"shiyi666777","disabled":false,"gated":false,"lastModified":"2026-09-07T09:02:59.000Z","likes":0,"private":false,"sha":"e3bdd2dd91a24675e73924e20836e321713d470d","downloads":1504,"tags":["license:cc-by-nc-sa-4.0","size_categories:100B<n<1T","modality:image","region:us","event"],"createdAt":"2026-09-07T09:02:55.000Z","key":""},{"_id":"67b1b67b1a97748bc6f0ca30","id":"labofsahil/github-event-dataset-2019","author":"labofsahil","disabled":false,"gated":false,"lastModified":"2025-02-16T11:51:30.000Z","likes":1,"private":false,"sha":"3d6521b285f332085698eb1ded3389970ec89798","downloads":1317,"tags":["license:mit","size_categories:100M<n<1B","format:parquet","modality:text","library:datasets","library:dask","library:mlcroissant","library:polars","region:us"],"createdAt":"2025-02-16T09:57:15.000Z","key":""},{"_id":"6a2283ba4647e7cd6ba0103d","id":"ARTPARK-IISc/Vaani-Noise-Event-Dataset","author":"ARTPARK-IISc","disabled":false,"gated":"auto","lastModified":"2026-08-07T17:51:17.000Z","likes":17,"private":false,"sha":"be488e2ac12fd62bef46b9f83e3a5feded575333","description":"\n\t\n\t\t\n\t\n\t\n\t\tVaani Noise Event Timestamps\n\t\n\n\n\t\n\t\t\n\t\n\t\n\t\tDataset Summary\n\t\n\nVaani Noise Event Timestamps is a derived dataset from Project Vaani, a large-scale multilingual speech initiative by IISc Bangalore and ARTPARK that captures India's linguistic diversity across all districts.\nThis dataset provides noise event annotations with fine-grained timestamps for the subset audio recordings from the Vaani corpus. Each entry identifies background noise categories along with their precise start… See the full description on the dataset page: https://huggingface.co/datasets/ARTPARK-IISc/Vaani-Noise-Event-Dataset.","downloads":757,"tags":["task_categories:audio-classification","license:cc-by-4.0","size_categories:10K<n<100K","format:parquet","modality:audio","modality:text","library:datasets","library:dask","library:polars","library:mlcroissant","arxiv:2603.28714","region:us","audio","noise-detection","sound-event-detection","noise-timestamps","vaani","indian-languages","speech","multilingual"],"createdAt":"2026-06-05T08:07:22.000Z","key":""},{"_id":"66c6cc8559ff3e4811a7c90a","id":"gokulbnr/QCR-Fast-Slow-Event-Dataset","author":"gokulbnr","disabled":false,"gated":false,"lastModified":"2026-06-24T10:43:28.000Z","likes":0,"private":false,"sha":"6465c8d6a8ea1abda9313c6e06b3ec2ae2f22527","description":"\n\t\n\t\t\n\t\n\t\n\t\tEnhancing Visual Place Recognition via Fast and Slow Adaptive Biasing in Event Cameras\n\t\n\n\n\n\n\n\nWelcome to the official QCR-Fast-Slow-Event-Dataset dataset repository attached to the paper Enhancing Visual Place Recognition via Fast and Slow Adaptive Biasing in Event Cameras, to be presented at the 2024 IEEE/RSJ International Conference on Intelligent Robots and Systems (IROS 2024). This work introduces feedback control algorithms that dynamically change bias parameters for… See the full description on the dataset page: https://huggingface.co/datasets/gokulbnr/QCR-Fast-Slow-Event-Dataset.","downloads":555,"tags":["license:mit","arxiv:2403.16425","region:us","robotics"],"createdAt":"2024-08-22T05:28:37.000Z","key":""},{"_id":"69c6be6e5b2fa163d7a7f413","id":"Yuchn/event-graph-vjepa-vitl-dataset","author":"Yuchn","disabled":false,"gated":false,"lastModified":"2026-03-27T17:47:02.000Z","likes":0,"private":false,"sha":"3545825d040250c99e079e958e7fd8dfa1cfa6ad","description":"\n\t\n\t\t\n\t\n\t\n\t\tEvent Graph Generation Dataset — V-JEPA 2.1 ViT-L Features + VLM Annotations\n\t\n\n\n\t\n\t\t\n\t\n\t\n\t\t1. データセット概要\n\t\n\n動画から構造化されたイベントグラフ（誰が・何を・どこから・どこへ）を予測するための学習データセットです。\n室内環境（デスク・キッチン・部屋）の録画動画を対象に、以下の 2 種類のデータを含みます：\n\n映像特徴量（Features）: V-JEPA 2.1 ViT-L（frozen）で抽出した時空間トークン（PyTorch .pt 形式）\n合成アノテーション（Annotations）: Qwen 3.5 VLM による自動生成アノテーション（JSON 形式）。オブジェクト検出・イベント（行動）記述を含む\n\n\n\t\n\t\t\n\t\n\t\n\t\t2. データの内容・件数\n\t\n\n\n\t\n\t\t\n項目\n値\n\n\n\t\t\n動画数\n5\n\n\nクリップ数（16フレーム/クリップ）\n933\n\n\n特徴量サイズ合計\n17.61 GB\n\n\nアノテーション JSON\n5 ファイル… See the full description on the dataset page: https://huggingface.co/datasets/Yuchn/event-graph-vjepa-vitl-dataset.","downloads":386,"tags":["task_categories:video-classification","language:ja","license:mit","size_categories:1K<n<10K","region:us","video-understanding","event-graph","vjepa","slot-attention","pytorch","synthetic-annotations"],"createdAt":"2026-03-27T17:29:18.000Z","key":""},{"_id":"690b020f86986bb6a53b77b8","id":"labofsahil/github-event-dataset-2023","author":"labofsahil","disabled":false,"gated":false,"lastModified":"2025-11-05T08:48:51.000Z","likes":0,"private":false,"sha":"f02a488d85d78e35850bc05549033c4dc78709c8","downloads":384,"tags":["size_categories:1B<n<10B","format:parquet","modality:text","library:datasets","library:dask","library:polars","library:mlcroissant","region:us"],"createdAt":"2025-11-05T07:51:43.000Z","key":""},{"_id":"6909a8924466a875ae763e33","id":"labofsahil/github-event-dataset-2021","author":"labofsahil","disabled":false,"gated":false,"lastModified":"2025-11-04T08:06:39.000Z","likes":0,"private":false,"sha":"d9385dec28aa2e9ecd158a8c5f75dadac1a3030e","downloads":351,"tags":["size_categories:100M<n<1B","format:parquet","modality:text","library:datasets","library:dask","library:mlcroissant","library:polars","region:us"],"createdAt":"2025-11-04T07:17:38.000Z","key":""},{"_id":"6909d30fea5958d57cef89a9","id":"labofsahil/github-event-dataset-2022","author":"labofsahil","disab