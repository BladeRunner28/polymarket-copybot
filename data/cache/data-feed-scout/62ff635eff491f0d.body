[{"_id":"6a1b7e67bf3a3b490d8daa91","id":"masonmarker/osha-severe-injury-reports-enriched","author":"masonmarker","disabled":false,"gated":false,"lastModified":"2026-05-31T00:29:00.000Z","likes":2,"private":false,"sha":"7831d39a5aec52755cbf24b5352557c17f207938","description":"\n\t\n\t\t\n\t\n\t\n\t\tOSHA Severe Injury Reports Enriched Dataset\n\t\n\nThis dataset packages OSHA Severe Injury Report records into a single analysis-ready dataframe covering January 1, 2015 through August 31, 2025.\nEach row represents one OSHA severe injury report submitted under federal OSHA jurisdiction. The dataset preserves the underlying establishment, geography, NAICS, incident classification, and narrative fields while adding normalized dates, NAICS sector mapping, severity profile fields… See the full description on the dataset page: https://huggingface.co/datasets/masonmarker/osha-severe-injury-reports-enriched.","downloads":533,"tags":["task_categories:tabular-classification","language:en","license:mit","size_categories:100K<n<1M","format:parquet","modality:tabular","modality:text","library:datasets","library:pandas","library:polars","library:mlcroissant","region:us","pandas","dataframe","generated","tabular","osha","workplace-safety","injury","compliance","risk-intelligence","operations"],"createdAt":"2026-05-31T00:18:47.000Z","key":""},{"_id":"6abe9df912fafb081e33439d","id":"multabench/extended-text-cls-osha-injury","author":"multabench","disabled":false,"gated":false,"lastModified":"2026-10-17T09:20:06.000Z","likes":0,"private":false,"sha":"9ccd5cef4f31764ecb7e550bf03a011279d2e226","description":"\n\t\n\t\t\n\t\n\t\n\t\tBIN_TEXT_OSHA_INJURY\n\t\n\nPart of MulTaBench, a benchmark for multimodal tabular learning.\nPaper: MulTaBench: Benchmarking Multimodal Tabular Learning with Text and Image · Leaderboard: multabench/leaderboard\n\nTarget: Task Assigned\nRows: 4847\nOriginal source: https://www.kaggle.com/ruqaiyaship/osha-accident-and-injury-data-1517\n\nLoad the benchmark splits with multabench.load_split(\"BIN_TEXT_OSHA_INJURY\", fold=0).\n\n\t\n\t\t\nColumn\nType\n\n\n\t\t\nEvent Date\ndatetime\n\n\nAbstract Text\nstring… See the full description on the dataset page: https://huggingface.co/datasets/multabench/extended-text-cls-osha-injury.","downloads":152,"tags":["size_categories:1K<n<10K","format:parquet","modality:text","modality:tabular","library:datasets","library:pandas","library:polars","library:mlcroissant","arxiv:2605.10616","region:us","multabench","tabular"],"createdAt":"2026-10-01T17:52:57.000Z","key":""},{"_id":"69b844d6012570d467860467","id":"Layered-Labs/neiss-injury-data","author":"Layered-Labs","disabled":false,"gated":false,"lastModified":"2026-03-27T01:46:10.000Z","likes":1,"private":false,"sha":"5bfb3220ad6bdb46c158b324d2a8ee23b1602cd1","description":"NEISS Injury Data\n\n7.3 million emergency department injury records from 2005 to 2024, consolidated into a single query-ready Parquet file.\n\n\n  \n    \n  \n  &nbsp;\n  \n    \n  \n  &nbsp;\n  \n\n\n\n  \n\n\n\n\n\t\n\t\t\n\t\n\t\n\t\tOverview\n\t\n\nNEISS Injury Data is the most complete publicly available consolidation of National Electronic\nInjury Surveillance System records, covering 7,326,429 emergency department visits associated\nwith consumer products, sports, and activities from 2005 through 2024. Each record is one ED… See the full description on the dataset page: https://huggingface.co/datasets/Layered-Labs/neiss-injury-data.","downloads":134,"tags":["task_categories:other","language:en","license:other","size_categories:1M<n<10M","format:parquet","modality:tabular","modality:text","library:datasets","library:pandas","library:polars","library:mlcroissant","region:us","neiss","injury","emergency-medicine","epidemiology","public-health","cpsc","tabular"],"createdAt":"2026-03-16T17:58:46.000Z","key":""},{"_id":"690ee0bfa7aab0cbafefa567","id":"who-is-tyler-durden/thailand-road-traffic-injury-aggregates-2018","author":"who-is-tyler-durden","disabled":false,"ga